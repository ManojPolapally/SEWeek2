# ============================================================
# TASK 1: CREATE AWS EC2 INSTANCE
# ============================================================

# 1. Login to AWS Console
# 2. Go to EC2 -> Launch Instance
# 3. Name: Ubuntu-Web-Server
# 4. AMI: Ubuntu Server
# 5. Architecture: 64-bit
# 6. Instance Type: t2.micro (if eligible)
# 7. Create Key Pair: labuser.pem
# 8. Network Settings:
#    Allow SSH (22) from your IP
#    Allow HTTP (80)
#    Allow HTTPS (443)
#    Add Custom TCP port 6060 from your IP
# 9. Storage: 8 GB or more
# 10. Click Launch Instance

# ============================================================
# TASK 2: CONNECT TO EC2 USING SSH
# ============================================================

# Run these commands in your LOCAL PowerShell terminal.

# Navigate to the folder containing your .pem file
cd "C:\Users\YourName\Downloads"

# Replace with your actual EC2 public DNS
ssh -i "labuser.pem" ubuntu@YOUR_EC2_PUBLIC_DNS

# After connecting, run the remaining commands in Ubuntu.

# ============================================================
# TASK 3: UPDATE UBUNTU AND INSTALL SOFTWARE
# ============================================================

sudo apt update

sudo apt install -y docker.io

sudo apt install -y git

sudo apt install -y nano

sudo apt install -y maven

# Start Docker
sudo systemctl start docker

# Enable Docker
sudo systemctl enable docker

# Check versions
sudo docker --version
git --version
mvn -version

# ============================================================
# TASK 4: CLONE MAVEN WEB APPLICATION FROM GITHUB
# ============================================================

# Example GitHub repository:
git clone https://github.com/kvrajanirajesh/mid2-hospitalmaven.git

# Enter project folder
cd mid2-hospitalmaven

# Check project files
ls

# Check pom.xml
cat pom.xml

# ============================================================
# TASK 5: BUILD MAVEN WEB APPLICATION
# ============================================================

# Compile, test and package
mvn clean package

# Check generated artifacts
ls target/

# IMPORTANT:
# A WAR file is required for the Tomcat Dockerfile below.
# If Maven produces only a JAR, use a WAR-packaged
# Maven web project instead.

# ============================================================
# TASK 6: CREATE DOCKERFILE
# ============================================================

nano Dockerfile

# Paste the following content into Dockerfile:

# ---------- START OF Dockerfile ----------

FROM tomcat:9-jdk11

COPY target/*.war /usr/local/tomcat/webapps/ROOT.war

EXPOSE 8080

CMD ["catalina.sh", "run"]

# ---------- END OF Dockerfile ----------

# Save Dockerfile in nano:
# CTRL + O
# ENTER
# CTRL + X

# Note:
# Use a Java/Tomcat version compatible with your application.
# This example assumes a WAR compatible with Tomcat 9.

# ============================================================
# TASK 7: BUILD DOCKER IMAGE
# ============================================================

sudo docker build -t mywebapp .

# Check Docker images
sudo docker images

# ============================================================
# TASK 8: RUN DOCKER CONTAINER
# ============================================================

sudo docker run -d \
  --name app-demo \
  --restart unless-stopped \
  -p 6060:8080 \
  mywebapp

# ============================================================
# TASK 9: CHECK CONTAINER STATUS
# ============================================================

sudo docker ps

# Check all containers
sudo docker ps -a

# Check application logs
sudo docker logs app-demo

